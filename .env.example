# ──────────────────────────────────────────────
# RAG NotebookLM - Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AI Provider ───────────────────────────────
# Choose which AI provider to use: "google" or "openai"
PROVIDER=google

# ── Google Gemini (required if PROVIDER=google) ──
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── OpenAI (required if PROVIDER=openai) ─────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Qdrant Vector Database ────────────────────
# Local (default when using Docker Compose):
QDRANT_URL=http://localhost:6333
# Leave empty if running locally without auth:
QDRANT_API_KEY=

# ── Optional Overrides ────────────────────────
# Server
# PORT=3000
# HOST=127.0.0.1

# Chunking
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# BATCH_SIZE=100
# CONCURRENCY=10

# Model names (defaults shown)
# GOOGLE_EMBED_MODEL=models/text-embedding-004
# GOOGLE_CHAT_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=text-embedding-3-large
# CHAT_MODEL=gpt-4o-mini

# Retrieval
# TOP_K=3
# SUBQUERY_COUNT=2
